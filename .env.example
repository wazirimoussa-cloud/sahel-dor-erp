# Copiez ce fichier vers .env.local et renseignez les valeurs de votre projet Supabase
# (Dashboard Supabase > Project Settings > API)

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Utilisé UNIQUEMENT par les scripts d'intégration et les Edge Functions,
# jamais exposé au frontend. Ne jamais committer une vraie valeur.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Utilisé UNIQUEMENT par les Edge Functions create-user/reset-password (voir
# supabase/functions/_shared/constants.ts) pour créer/réinitialiser un compte au mot de
# passe partagé par défaut. Déployé via `npx supabase secrets set DEFAULT_PASSWORD=...`,
# jamais committé en dur (corrigé lors de l'audit sécurité du 2026-08-04).
DEFAULT_PASSWORD=your-default-password

# Optionnel : affiche une bannière en haut de l'app (ex. déploiement de formation/démo,
# pour éviter toute confusion avec la production). Laisser vide en production.
VITE_APP_LABEL=

# Comptes provisoires Formation utilisés par les tests d'intégration
# (tests/integration/*.test.ts, `npm run test:integration`) -- jamais Production.
# Un compte par profil, car le test vérifie la vraie séparation des tâches (RLS +
# attributions), pas une simulation. Laisser vide pour ignorer ces tests (ils sont
# alors sautés, jamais en échec) plutôt que d'exiger un secret réseau pour `npm test`.
TEST_GERANT_LOGIN=gerant.formation
TEST_GERANT_PASSWORD=
TEST_MAGASINIER_LOGIN=magasinier.formation
TEST_MAGASINIER_PASSWORD=
TEST_SUPERVISEUR_LOGIN=superviseur.formation
TEST_SUPERVISEUR_PASSWORD=
TEST_COMPTABLE_LOGIN=comptable.formation
TEST_COMPTABLE_PASSWORD=
TEST_ADMIN_LOGIN=admin.formation
TEST_ADMIN_PASSWORD=
